---
// Calculadora de Proteína Diária por Objetivo e Peso Corporal
---

<div class="calculator-card" id="protein-calculator">
  <div class="calculator-header">
    <div class="calc-badge">Preservação Muscular & Saciedade</div>
    <h2 class="calc-title">Calculadora de Proteína Diária</h2>
    <p class="calc-subtitle">
      Calcule a ingestão proteica ideal por dia para proteger seus músculos durante o emagrecimento, controlar a fome e acelerar sua recuperação.
    </p>
  </div>

  <form id="protein-form" class="calc-form" novalidate>
    <div class="calc-grid">
      <div class="form-group">
        <label for="prot-weight" class="form-label">Seu Peso Corporal Atual (kg)</label>
        <div class="input-wrapper">
          <input 
            type="number" 
            id="prot-weight" 
            name="weight" 
            min="30" 
            max="250" 
            step="0.5" 
            placeholder="Ex: 70" 
            required 
            class="form-input" 
          />
          <span class="input-unit">kg</span>
        </div>
      </div>

      <div class="form-group">
        <label for="prot-meals" class="form-label">Quantas Refeições Faz por Dia?</label>
        <select id="prot-meals" name="meals" class="form-select" required>
          <option value="3">3 refeições diárias</option>
          <option value="4" selected>4 refeições diárias (café, almoço, lanche, jantar)</option>
          <option value="5">5 refeições diárias</option>
          <option value="6">6 refeições menores</option>
        </select>
      </div>
    </div>

    <!-- Objetivo Nutricional Principal -->
    <div class="form-group">
      <label for="prot-goal" class="form-label">Qual é o seu Objetivo Atual?</label>
      <select id="prot-goal" name="goal" class="form-select" required>
        <option value="fat_loss" selected>Emagrecimento / Déficit Calórico (1.8g - 2.2g/kg para saciedade e não queimar músculos)</option>
        <option value="hypertrophy">Hipertrofia / Ganho de Massa Muscular (1.6g - 2.0g/kg)</option>
        <option value="maintenance">Manutenção do Peso & Longevidade (1.2g - 1.5g/kg)</option>
        <option value="endurance">Esportes de Resistência / Corrida (1.2g - 1.4g/kg)</option>
        <option value="sedentary">Sedentário / Saúde Básica OMS (0.8g - 1.0g/kg)</option>
      </select>
    </div>

    <div class="calc-buttons">
      <button type="submit" class="btn btn-primary btn-calc">Calcular Meta de Proteína</button>
      <button type="reset" id="prot-reset" class="btn btn-secondary btn-reset">Limpar</button>
    </div>
  </form>

  <!-- Painel de Resultados -->
  <div id="prot-result-panel" class="result-panel" style="display: none;" aria-live="polite">
    <div class="protein-results-grid">
      <!-- Total Diário Recomendado -->
      <div class="prot-stat-card target-card">
        <span class="stat-badge stat-badge-target">Total Diário Recomendado</span>
        <div class="stat-number-wrapper">
          <span id="prot-total-display" class="stat-number">--</span>
          <span class="stat-unit">g / dia</span>
        </div>
        <p class="stat-desc">
          Faixa ideal recomendada: <strong id="prot-range-display">-- g a -- g</strong> por dia.
        </p>
      </div>

      <!-- Média por Refeição -->
      <div class="prot-stat-card">
        <span class="stat-badge">Média por Refeição</span>
        <div class="stat-number-wrapper">
          <span id="prot-per-meal-display" class="stat-number">--</span>
          <span class="stat-unit">g / refeição</span>
        </div>
        <p class="stat-desc">
          Distribuir a proteína ao longo do dia otimiza a síntese de proteínas musculares e mantém a fome sob controle.
        </p>
      </div>
    </div>

    <!-- Exemplos Práticos de Alimentos -->
    <div class="food-examples-section">
      <h3 class="examples-title">Como Atingir Essa Meta com Alimentos Reais?</h3>
      <p class="examples-sub">
        Fontes de alta densidade proteica para facilitar sua rotina diária:
      </p>

      <div class="food-grid">
        <div class="food-item">
          <strong>Peito de Frango (100g pesado cozido)</strong>
          <span>≈ 31g de proteína</span>
        </div>
        <div class="food-item">
          <strong>3 Ovos Inteiros Grandes</strong>
          <span>≈ 18g de proteína</span>
        </div>
        <div class="food-item">
          <strong>Iogurte Grego Natural (150g)</strong>
          <span>≈ 12g a 15g de proteína</span>
        </div>
        <div class="food-item">
          <strong>1 Scoop de Whey Protein (30g)</strong>
          <span>≈ 22g a 24g de proteína</span>
        </div>
        <div class="food-item">
          <strong>Atum em Lata Conservado (1 lata)</strong>
          <span>≈ 26g de proteína</span>
        </div>
        <div class="food-item">
          <strong>Tofu Firme (150g) / Lentilhas Cozidas (1 xícara)</strong>
          <span>≈ 15g a 18g de proteína vegetal</span>
        </div>
      </div>
    </div>

    <!-- CTA de Dica -->
    <div class="contextual-cta">
      <div class="cta-inner-box">
        <div class="cta-text">
          <strong>Precisa saber quantas calorias consumir ao todo?</strong>
          <p>Alinhe sua ingestão de proteína com o cálculo preciso do seu gasto calórico total.</p>
        </div>
        <a href="/ferramentas/calculadora-calorias" class="btn btn-secondary btn-sm">
          Calcular Gasto Calórico &rarr;
        </a>
      </div>
    </div>
  </div>

  <div class="health-disclaimer">
    <strong>Aviso Importante sobre Saúde Renal:</strong> As faixas de proteína acima são amplamente seguras e recomendadas pela Sociedade Internacional de Nutrição Esportiva (ISSN) para pessoas com função renal saudável. Indivíduos com histórico de doença renal crônica pré-existente devem seguir estritamente o limite estabelecido por seu médico nefrologista e nutricionista.
  </div>
</div>

<style>
  .calculator-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    margin: 2rem 0;
  }

  .calc-badge {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background-color: var(--color-primary-soft);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
  }

  .calc-title {
    font-size: 1.6rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .calc-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    background-color: #fafbf9;
    color: var(--color-text-main);
    transition: border-color var(--transition-fast);
  }

  .form-input {
    padding-right: 2.5rem;
  }

  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: var(--color-primary-light);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.15);
  }

  .input-unit {
    position: absolute;
    right: 0.9rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
    pointer-events: none;
    font-weight: 500;
  }

  .calc-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .btn-calc {
    flex: 2;
  }

  .btn-reset {
    flex: 1;
  }

  /* Resultados */
  .result-panel {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .protein-results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .prot-stat-card {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .target-card {
    background: #edf7f0;
    border-color: #a3d9b4;
  }

  .stat-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .stat-badge-target {
    color: var(--color-primary);
  }

  .stat-number-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .stat-unit {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .stat-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0.5rem 0 0 0;
  }

  .food-examples-section {
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .examples-title {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    color: var(--color-primary);
  }

  .examples-sub {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .food-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .food-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .food-item strong {
    font-size: 0.88rem;
    color: var(--color-text-main);
  }

  .food-item span {
    font-size: 0.8rem;
    color: var(--color-primary-light);
    font-weight: 600;
  }

  .contextual-cta {
    background-color: #f7faf8;
    border: 1px solid #d5e5db;
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cta-inner-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .cta-text strong {
    display: block;
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  .cta-text p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0.2rem 0 0 0;
  }

  @media (max-width: 650px) {
    .calculator-card {
      padding: 1.25rem;
    }
    .cta-inner-box {
      flex-direction: column;
      align-items: flex-start;
    }
    .calc-buttons {
      flex-direction: column;
    }
  }
</style>

<script>
  (function initProteinCalculator() {
    const form = document.getElementById('protein-form') as HTMLFormElement;
    const resetBtn = document.getElementById('prot-reset');
    const resultPanel = document.getElementById('prot-result-panel');
    const totalDisplay = document.getElementById('prot-total-display');
    const rangeDisplay = document.getElementById('prot-range-display');
    const perMealDisplay = document.getElementById('prot-per-meal-display');

    if (!form || !resultPanel) return;

    // Fatores proteicos em g por kg de peso
    const goalFactors: Record<string, { min: number; target: number; max: number }> = {
      fat_loss: { min: 1.8, target: 2.0, max: 2.2 },
      hypertrophy: { min: 1.6, target: 1.8, max: 2.0 },
      maintenance: { min: 1.2, target: 1.4, max: 1.6 },
      endurance: { min: 1.2, target: 1.3, max: 1.4 },
      sedentary: { min: 0.8, target: 0.9, max: 1.0 }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const weightInput = document.getElementById('prot-weight') as HTMLInputElement;
      const mealsSelect = document.getElementById('prot-meals') as HTMLSelectElement;
      const goalSelect = document.getElementById('prot-goal') as HTMLSelectElement;

      const weight = parseFloat(weightInput.value);
      const meals = parseInt(mealsSelect.value, 10);
      const goalKey = goalSelect.value;

      if (!weight || weight <= 0) {
        alert('Por favor, informe seu peso corporal.');
        return;
      }

      const factors = goalFactors[goalKey] || goalFactors.fat_loss;
      const targetProtein = Math.round(weight * factors.target);
      const minProtein = Math.round(weight * factors.min);
      const maxProtein = Math.round(weight * factors.max);
      const proteinPerMeal = Math.round(targetProtein / meals);

      if (totalDisplay) totalDisplay.textContent = String(targetProtein);
      if (rangeDisplay) rangeDisplay.textContent = `${minProtein}g a ${maxProtein}g`;
      if (perMealDisplay) perMealDisplay.textContent = String(proteinPerMeal);

      resultPanel.style.display = 'block';
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Dispara evento GA4
      if (typeof window !== 'undefined' && 'gtag' in window && typeof window.gtag === 'function') {
        window.gtag('event', 'tool_used', {
          tool_name: 'calculadora_proteina',
          goal: goalKey
        });
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        resultPanel.style.display = 'none';
      });
    }
  })();
</script>
