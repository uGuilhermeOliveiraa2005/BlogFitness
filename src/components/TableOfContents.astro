---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Apenas h2 e h3 para sumários limpos
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-container" aria-label="Sumário do artigo">
    <div class="toc-header">
      <span class="toc-icon" aria-hidden="true">§</span>
      <h2 class="toc-title">Neste artigo</h2>
    </div>
    <ul class="toc-list">
      {filteredHeadings.map((heading) => (
        <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`} class="toc-link">
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-container {
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .toc-icon {
    color: var(--color-primary-light);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .toc-title {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  .toc-depth-3 {
    padding-left: 1.25rem;
    font-size: 0.9em;
  }

  .toc-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
