---
import { SITE } from '../utils/constants';

interface Props {
  slotId?: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'sidebar';
  label?: string;
  className?: string;
}

const {
  slotId = '0000000000',
  format = 'auto',
  label = 'Publicidade',
  className = ''
} = Astro.props;

const adClient = SITE.adsenseId;
---

<div class:list={['ad-wrapper', `ad-format-${format}`, className]}>
  <div class="ad-label">{label}</div>
  <div class="ad-container">
    {/* Bloco AdSense Responsivo com espaço reservado para zero CLS */}
    <ins 
      class="adsbygoogle"
      style="display:block"
      data-ad-client={adClient}
      data-ad-slot={slotId}
      data-ad-format={format === 'sidebar' ? 'vertical' : (format === 'auto' ? 'auto' : format)}
      data-full-width-responsive="true"
    ></ins>
    <div class="ad-placeholder" aria-hidden="true">
      <span>Espaço Reservado para Anúncio</span>
    </div>
  </div>
</div>

<style>
  .ad-wrapper {
    margin: 2.5rem auto;
    text-align: center;
    width: 100%;
    max-width: 100%;
    clear: both;
  }

  .ad-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: 0.35rem;
  }

  .ad-container {
    position: relative;
    background-color: #f7f8f6;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Reserva estrita de espaço para evitar Cumulative Layout Shift (CLS) */
  .ad-format-auto .ad-container {
    min-height: 250px;
  }

  .ad-format-horizontal .ad-container {
    min-height: 90px;
    max-width: 728px;
    margin: 0 auto;
  }

  .ad-format-rectangle .ad-container {
    min-height: 280px;
    max-width: 336px;
    margin: 0 auto;
  }

  .ad-format-sidebar .ad-container {
    min-height: 600px;
    max-width: 300px;
    margin: 0 auto;
  }

  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aa39d;
    font-size: 0.75rem;
    padding: 1rem;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Quando o AdSense carrega, ele preenche o ins e sobrepõe o placeholder */
  ins.adsbygoogle[data-ad-status="filled"] + .ad-placeholder,
  ins.adsbygoogle[data-adsbygoogle-status="done"] + .ad-placeholder {
    display: none;
  }
</style>

<script>
  // Inicialização segura do script de anúncios se o script global do AdSense estiver presente
  declare global {
    interface Window {
      adsbygoogle: unknown[];
    }
  }

  try {
    if (typeof window !== 'undefined') {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    }
  } catch {
    // Silencia erros caso bloqueador de anúncio esteja ativo
  }
</script>
