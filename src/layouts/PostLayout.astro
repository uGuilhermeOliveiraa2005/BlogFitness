---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ProductCTA from '../components/ProductCTA.astro';
import AdSlot from '../components/AdSlot.astro';
import { formatDate } from '../utils/formatDate';
import { CATEGORIES, SITE } from '../utils/constants';
import { generateArticleSchema, generateBreadcrumbSchema, type FAQItem } from '../utils/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  slug?: string;
  authorData?: CollectionEntry<'authors'>['data'];
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: CollectionEntry<'posts'>[];
  faqs?: FAQItem[];
}

const { post, slug: propSlug, authorData, headings, relatedPosts = [] } = Astro.props;
const { data } = post;
const slug = propSlug || post.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || post.id;

const categoryInfo = CATEGORIES[data.category] || { label: data.category, description: '' };
const articleUrl = `/blog/${slug}`;

const breadcrumbItems = [
  { name: 'Blog', url: '/blog' },
  { name: categoryInfo.label, url: `/categoria/${data.category}` },
  { name: data.title, url: articleUrl }
];

const articleSchema = generateArticleSchema({
  title: data.title,
  description: data.description,
  url: articleUrl,
  image: data.heroImage,
  pubDate: data.pubDate,
  updatedDate: data.updatedDate,
  authorName: authorData?.name || data.author,
  authorCredentials: authorData?.credentials
});

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);

const schemas = [articleSchema, breadcrumbSchema];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.heroImage}
  canonicalUrl={data.seo?.canonicalUrl || `${SITE.url}${articleUrl}`}
  noindex={data.seo?.noindex}
  type="article"
  schema={schemas}
>
  <article class="article-page">
    <header class="article-header container-narrow">
      <Breadcrumbs items={breadcrumbItems} />

      <a href={`/categoria/${data.category}`} class="category-badge">
        {categoryInfo.label}
      </a>

      <h1 class="article-title">{data.title}</h1>
      
      <p class="article-lead">{data.description}</p>

      <div class="article-meta-bar">
        <div class="author-meta">
          {authorData?.avatar ? (
            <img src={authorData.avatar} alt={authorData.name} class="author-avatar" width="44" height="44" />
          ) : (
            <div class="author-avatar-placeholder">{authorData?.name?.charAt(0) || 'A'}</div>
          )}
          <div class="author-info">
            <span class="author-name">{authorData?.name || data.author}</span>
            {authorData?.credentials && <span class="author-cred">{authorData.credentials}</span>}
          </div>
        </div>

        <div class="post-timing">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          {data.updatedDate && (
            <span class="updated-date">· Atualizado em {formatDate(data.updatedDate)}</span>
          )}
          <span class="reading-time">· Leitura de ~{data.readingTime} min</span>
        </div>
      </div>

      <!-- Isenção e Transparência Editorial Obrigatória (E-E-A-T) -->
      <div class="editorial-notice">
        <div class="notice-badge">Transparência & Saúde</div>
        <p>
          Este conteúdo é revisado e fundamentado em literatura científica sobre nutrição e fisiologia. Não substitui consulta médica ou nutricional individualizada. Alguns links contidos neste artigo podem ser de parceiros afiliados.
        </p>
      </div>

      {data.heroImage && (
        <figure class="hero-image-wrapper">
          <img 
            src={data.heroImage} 
            alt={data.heroImageAlt || data.title} 
            class="hero-image"
            loading="eager"
            fetchpriority="high"
          />
          {data.heroImageAlt && <figcaption>{data.heroImageAlt}</figcaption>}
        </figure>
      )}
    </header>

    <div class="container-narrow">
      {/* Sumário do Artigo */}
      <TableOfContents headings={headings} />

      {/* Corpo do Artigo */}
      <div class="prose">
        <slot />
      </div>

      {/* Produtos Afiliados Contextuais Cadastrados no Artigo */}
      {data.affiliateProducts && data.affiliateProducts.length > 0 && (
        <section class="affiliate-section" aria-label="Recomendações de produtos">
          <h2 class="section-title">Recomendações e Ferramentas Indicadas</h2>
          {data.affiliateProducts.map((prod) => (
            <ProductCTA
              nome={prod.nome}
              url={prod.url}
              imagem={prod.imagem}
              descricaoCurta={prod.descricaoCurta}
              botaoTexto={prod.botaoTexto}
              origemArtigo={slug}
            />
          ))}
        </section>
      )}

      {/* Anúncio Display Pós-Conteúdo e Pós-CTA (Regra AdSense Seção 5) */}
      <AdSlot slotId="9988776655" format="auto" label="Publicidade Patrocinada" />

      {/* Box do Autor (E-E-A-T do Google) */}
      {authorData && (
        <div class="author-bio-card">
          <div class="author-bio-avatar-col">
            <img src={authorData.avatar} alt={authorData.name} class="author-bio-img" />
          </div>
          <div class="author-bio-content">
            <div class="author-bio-badge">Sobre o Autor / Revisor</div>
            <h3 class="author-bio-name">{authorData.name}</h3>
            <p class="author-bio-role">{authorData.credentials}</p>
            <p class="author-bio-text">{authorData.bio}</p>
          </div>
        </div>
      )}

      {/* Artigos Relacionados */}
      {relatedPosts.length > 0 && (
        <div class="related-posts-section">
          <h3 class="related-heading">Leia Também</h3>
          <div class="related-grid">
            {relatedPosts.slice(0, 3).map((related) => {
              const relSlug = related.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || related.id;
              return (
                <a href={`/blog/${relSlug}`} class="related-card">
                  <span class="related-category">{CATEGORIES[related.data.category]?.label || related.data.category}</span>
                  <h4 class="related-title">{related.data.title}</h4>
                  <time class="related-date">{formatDate(related.data.pubDate)}</time>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-title {
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .article-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
  }

  .author-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-avatar-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .author-cred {
    font-size: 0.78rem;
    color: var(--color-text-light);
  }

  .post-timing {
    color: var(--color-text-light);
  }

  .editorial-notice {
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1.1rem;
    margin-bottom: 1.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .notice-badge {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .editorial-notice p {
    margin: 0;
  }

  .hero-image-wrapper {
    margin: 2rem 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-soft);
  }

  .hero-image {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
  }

  figcaption {
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    color: var(--color-text-light);
    text-align: center;
  }

  .affiliate-section {
    margin: 3rem 0;
  }

  .section-title {
    font-size: 1.4rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .author-bio-card {
    display: flex;
    gap: 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 3rem 0 2rem 0;
  }

  .author-bio-avatar-col {
    flex-shrink: 0;
  }

  .author-bio-img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-bio-badge {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-primary-light);
    margin-bottom: 0.25rem;
  }

  .author-bio-name {
    font-size: 1.2rem;
    margin: 0 0 0.2rem 0;
    color: var(--color-primary);
  }

  .author-bio-role {
    font-size: 0.82rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .author-bio-text {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .related-posts-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-heading {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .related-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem;
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .related-card:hover {
    border-color: var(--color-primary-light);
    text-decoration: none;
  }

  .related-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 700;
    display: block;
    margin-bottom: 0.4rem;
  }

  .related-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
    line-height: 1.4;
    margin: 0 0 0.5rem 0;
  }

  .related-date {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  @media (max-width: 600px) {
    .author-bio-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .article-meta-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
