---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import { CATEGORIES } from '../../utils/constants';
import { getSlug } from '../../utils/slug';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((catKey) => ({
    params: { categoria: catKey }
  }));
}

const { categoria } = Astro.params;
const categoryInfo = CATEGORIES[categoria] || { label: categoria, description: '' };

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.category === categoria);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'Categorias', url: '/blog' },
  { name: categoryInfo.label, url: `/categoria/${categoria}` }
];
---

<BaseLayout
  title={`${categoryInfo.label} | Artigos e Dicas`}
  description={categoryInfo.description}
>
  <div class="category-page container">
    <header class="category-header">
      <Breadcrumbs items={breadcrumbs} />
      <span class="category-tag">Categoria Editorial</span>
      <h1 class="category-title">{categoryInfo.label}</h1>
      <p class="category-desc">{categoryInfo.description}</p>
    </header>

    {sortedPosts.length === 0 ? (
      <div class="empty-state">
        <p>Ainda não há artigos publicados nesta categoria. Em breve novos conteúdos serão adicionados.</p>
        <a href="/blog" class="btn btn-secondary">Ver todos os artigos</a>
      </div>
    ) : (
      <div class="posts-category-grid">
        {sortedPosts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${getSlug(post.id)}`} class="post-card-thumb">
              <img 
                src={post.data.heroImage} 
                alt={post.data.heroImageAlt || post.data.title} 
                class="thumb-img"
                loading="lazy" 
              />
            </a>
            <div class="post-card-content">
              <h2 class="post-card-title">
                <a href={`/blog/${getSlug(post.id)}`}>{post.data.title}</a>
              </h2>
              <p class="post-card-desc">{post.data.description}</p>
              <div class="card-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span>· ~{post.data.readingTime} min</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .category-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .category-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary-light);
    display: block;
    margin-bottom: 0.4rem;
  }

  .category-title {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .category-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .posts-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .post-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .post-card-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface-soft);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .post-card:hover .thumb-img {
    transform: scale(1.03);
  }

  .post-card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-card-title {
    font-size: 1.25rem;
    margin: 0.2rem 0 0.6rem 0;
    line-height: 1.35;
  }

  .post-card-title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .post-card-title a:hover {
    text-decoration: underline;
  }

  .post-card-desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-meta {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>
