---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Contato', url: '/contato' }
];
---

<BaseLayout
  title="Fale Conosco | Contato Editorial & Dúvidas"
  description="Entre em contato com a equipe editorial do Vida & Peso para sugestões de pautas, dúvidas sobre calculadoras ou esclarecimentos."
>
  <div class="contact-page container-narrow">
    <header class="page-header">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="page-title">Fale Conosco</h1>
      <p class="page-lead">
        Tem alguma sugestão de pauta, encontrou alguma inconsistência técnica ou deseja enviar um feedback sobre nossas calculadoras? Adoraríamos ouvir você.
      </p>
    </header>

    <div class="contact-grid">
      <!-- Formulário de Contato -->
      <div class="contact-form-container">
        <form 
          id="contact-form" 
          class="contact-form" 
          action="#" 
          method="POST"
          onsubmit="event.preventDefault(); document.getElementById('contact-success').style.display = 'block'; this.reset();"
        >
          <div class="form-group">
            <label for="name" class="form-label">Nome Completo</label>
            <input type="text" id="name" name="name" required class="form-input" placeholder="Seu nome" />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Seu Melhor E-mail</label>
            <input type="email" id="email" name="email" required class="form-input" placeholder="seuemail@exemplo.com" />
          </div>

          <div class="form-group">
            <label for="subject" class="form-label">Assunto</label>
            <select id="subject" name="subject" class="form-select" required>
              <option value="duvida">Dúvida sobre as Calculadoras</option>
              <option value="sugestao">Sugestão de Artigo / Conteúdo</option>
              <option value="correcao">Correção ou Atualização Científica</option>
              <option value="parceria">Parceria Ética / Imprensa</option>
              <option value="outro">Outro assunto</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Sua Mensagem</label>
            <textarea id="message" name="message" rows="5" required class="form-textarea" placeholder="Descreva sua dúvida ou sugestão em detalhes..."></textarea>
          </div>

          <!-- Cloudflare Turnstile (Proteção Anti-Bot Gratuita) -->
          <div class="cf-turnstile-wrapper">
            <div class="cf-turnstile-placeholder">
              <span class="shield-icon">🛡️</span>
              <small>Formulário protegido por Cloudflare Turnstile anti-bot (gratuito).</small>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-submit">Enviar Mensagem</button>
        </form>

        <div id="contact-success" class="alert-success" style="display: none;">
          <strong>Obrigado pelo contato!</strong> Sua mensagem foi registrada e retornaremos em até 48 horas úteis.
        </div>
      </div>

      <!-- Informações Complementares -->
      <aside class="contact-info-panel">
        <div class="info-card">
          <h3>Canais Diretos</h3>
          <p>Para dúvidas institucionais ou notificações legais:</p>
          <p class="contact-direct">
            <strong>E-mail:</strong> contato@vidae-peso.com.br
          </p>
          <p class="contact-direct">
            <strong>Tempo de resposta:</strong> Até 2 dias úteis
          </p>
        </div>

        <div class="info-card notice-card">
          <h4>Aviso Importante</h4>
          <p>
            Nossa equipe <strong>não prescreve dietas nem responde a emergências médicas</strong> por e-mail ou mensagens de contato. Em caso de sintomas clínicos agudos ou necessidade de plano dietético individual, procure atendimento presencial em um posto de saúde ou clínica médica.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
  }

  .contact-form-container {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    background-color: #fafbf9;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary-light);
    background-color: #ffffff;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .cf-turnstile-wrapper {
    margin: 1.25rem 0;
  }

  .cf-turnstile-placeholder {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--color-surface-soft);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .btn-submit {
    width: 100%;
  }

  .alert-success {
    margin-top: 1.5rem;
    padding: 1rem;
    background-color: #edf7f0;
    border: 1px solid #a3d9b4;
    border-radius: var(--radius-sm);
    color: var(--color-primary);
  }

  .contact-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .info-card h3, .info-card h4 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    color: var(--color-primary);
  }

  .info-card p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .contact-direct {
    margin-bottom: 0.35rem !important;
  }

  .notice-card {
    background: #fdfbf7;
    border-color: #eee4d5;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
